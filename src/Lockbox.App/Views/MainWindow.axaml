<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lockbox.App.ViewModels"
        xmlns:c="using:Lockbox.App.Controls"
        x:Class="Lockbox.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/lockbox.ico"
        Width="1140" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        <!-- Update banner -->
        <Border Background="#16284A" BorderBrush="#24406F" BorderThickness="0,0,0,1" Padding="16,8" IsVisible="{Binding UpdateBannerVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <PathIcon Data="{StaticResource IconImport}" Foreground="#9EC0FF" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <Run Text="Lockbox" FontWeight="SemiBold" />
                    <Run Text="{Binding UpdateVersion}" FontWeight="SemiBold" />
                    <Run Text=" is available." />
                </TextBlock>
                <Button Grid.Column="2" Classes="ghost" Content="What's new" Command="{Binding ShowUpdateNotesCommand}" Margin="0,0,6,0" />
                <Panel Grid.Column="3">
                    <Button Classes="accent" Content="Update and restart" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding UpdateIdle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UpdateBusy}" VerticalAlignment="Center">
                        <ProgressBar Width="140" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" />
                        <TextBlock Classes="dim" FontSize="12" Text="Downloading and checking signature…" />
                    </StackPanel>
                </Panel>
                <Button AutomationProperties.Name="Dismiss update notice" Grid.Column="4" Classes="icon" Command="{Binding DismissUpdateCommand}" ToolTip.Tip="Later" Margin="6,0,0,0"
                        IsVisible="{Binding UpdateIdle}">
                    <PathIcon Data="{StaticResource IconClose}" />
                </Button>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

        <!-- In-window dialog -->
        <Panel Grid.RowSpan="2" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Background="#B8000000" />
            <Border Classes="card" Width="{Binding Width}" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding Dialog}" x:DataType="vm:DialogViewModel" BoxShadow="0 20 60 0 #80000000">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="dim" LineHeight="21" IsVisible="{Binding IsPlainText}" />
                        <c:MarkdownView Markdown="{Binding Message}" IsVisible="{Binding IsMarkdown}" />

                        <StackPanel IsVisible="{Binding HasInput}">
                            <TextBlock Classes="label" Text="{Binding InputLabel}" />
                            <TextBox AutomationProperties.Name="Answer" Name="DialogInput" Text="{Binding Input}" PasswordChar="•" Classes="revealPasswordButton">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding HasConfirm}">
                            <TextBlock Classes="label" Text="{Binding ConfirmLabel}" />
                            <TextBox AutomationProperties.Name="Confirm answer" Text="{Binding ConfirmInput}" PasswordChar="•" Classes="revealPasswordButton">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <TextBlock Classes="error" Text="{Binding Error}"
                                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DialogButton">
                                    <Button Content="{Binding Label}"
                                            Command="{Binding $parent[ItemsControl].((vm:DialogViewModel)DataContext).PressCommand}"
                                            CommandParameter="{Binding}"
                                            Classes.accent="{Binding IsPrimary}"
                                            Classes.dangerSolid="{Binding IsDanger}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>
    </Grid>
</Window>
