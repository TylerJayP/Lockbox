<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lockbox.App.ViewModels"
             x:Class="Lockbox.App.Views.VaultView"
             x:DataType="vm:VaultViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewEntryCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding CopySelectedUsernameCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopySelectedPasswordCommand}" />
        <KeyBinding Gesture="Ctrl+U" Command="{Binding OpenSelectedUrlCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="*,Auto">
        <Grid ColumnDefinitions="340,*">
            <!-- Sidebar -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="16,14,10,10">
                        <Image Source="/Assets/lockbox.png" Width="26" Height="26" />
                        <TextBlock Grid.Column="1" Classes="h3" Text="{Binding VaultName}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button AutomationProperties.Name="Home" Grid.Column="2" Classes="icon" Command="{Binding GoHomeCommand}"
                                ToolTip.Tip="Home: close the open item so nothing private is on screen">
                            <PathIcon Data="{StaticResource IconHome}" />
                        </Button>
                        <Button AutomationProperties.Name="Security check-up" Grid.Column="3" Classes="icon" Command="{Binding OpenCheckupCommand}" ToolTip.Tip="Security check-up">
                            <PathIcon Data="{StaticResource IconShield}" />
                        </Button>
                        <Button AutomationProperties.Name="Settings" Grid.Column="4" Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
                            <PathIcon Data="{StaticResource IconCog}" />
                        </Button>
                        <Button AutomationProperties.Name="Lock now" Grid.Column="5" Classes="icon" Command="{Binding LockCommand}" ToolTip.Tip="Lock now (Ctrl+L)">
                            <PathIcon Data="{StaticResource IconLock}" />
                        </Button>
                    </Grid>

                    <TextBox AutomationProperties.Name="Search" Grid.Row="1" Name="SearchBox" Margin="14,0,14,10" Text="{Binding Search}" PlaceholderText="Search (Ctrl+F)">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Margin="10,0,0,0" Foreground="{StaticResource TextDim}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="14,0,14,10">
                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Ctrl+N for a new login">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="New item" />
                                <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="Login" Command="{Binding NewItemCommand}" CommandParameter="Login">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconKey}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Secure note" Command="{Binding NewItemCommand}" CommandParameter="SecureNote">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconNote}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Payment card" Command="{Binding NewItemCommand}" CommandParameter="Card">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconCard}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Wi-Fi network" Command="{Binding NewItemCommand}" CommandParameter="WiFi">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconWifi}" /></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding OpenImportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconImport}" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="3" Classes="chips" Margin="12,0,12,8" ItemsSource="{x:Static vm:VaultViewModel.TypeFilters}"
                             SelectedItem="{Binding TypeFilter}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypeFilter">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ToggleButton Grid.Row="4" Margin="14,0,14,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  IsChecked="{Binding OnlyNeedsAttention}" Background="{StaticResource WarnSoft}"
                                  ToolTip.Tip="Weak, reused or empty passwords. Click to show only these."
                                  IsVisible="{Binding HasAttention}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconAlert}" Foreground="{StaticResource WarnBrush}" Width="14" Height="14" />
                            <TextBlock Foreground="{StaticResource WarnBrush}">
                                <Run Text="{Binding AttentionCount}" />
                                <Run Text=" items need attention" />
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>

                    <ListBox Grid.Row="5" Name="EntryList" Classes="entries" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CopySelectedPasswordCommand}" />
                            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectedPasswordCommand}" />
                            <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
                        </ListBox.KeyBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntryItemViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy password / number"
                                                      Command="{Binding $parent[ListBox].((vm:VaultViewModel)DataContext).CopyPasswordCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Copy username / name"
                                                      Command="{Binding $parent[ListBox].((vm:VaultViewModel)DataContext).CopyUsernameCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{Binding AvatarBrush}">
                                        <Panel>
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontWeight="Bold" Foreground="White" IsVisible="{Binding ShowInitial}" />
                                            <PathIcon Data="{Binding TypeIcon}" Foreground="White" Width="17" Height="17"
                                                      IsVisible="{Binding !ShowInitial}" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconAlert}" Foreground="{StaticResource WarnBrush}" Width="13" Height="13"
                                                  IsVisible="{Binding NeedsAttention}" ToolTip.Tip="{Binding IssueText}" />
                                        <PathIcon Data="{StaticResource IconLock}" Foreground="{StaticResource TextDim}" Width="12" Height="12"
                                                  IsVisible="{Binding IsProtected}" ToolTip.Tip="Asks for your master password" />
                                        <PathIcon Data="{StaticResource IconClip}" Foreground="{StaticResource TextDim}" Width="13" Height="13"
                                                  IsVisible="{Binding HasAttachments}" ToolTip.Tip="Has attachments" />
                                        <Border Classes="badge" IsVisible="{Binding HasTwoFactor}" ToolTip.Tip="2FA is on">
                                            <TextBlock Text="2FA" />
                                        </Border>
                                        <PathIcon Data="{StaticResource IconKey}" Width="13" Height="13" Foreground="#9EC0FF"
                                                  IsVisible="{Binding HasCodes}" ToolTip.Tip="Backup codes saved (sealed)" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="5" Margin="24,30" Spacing="8" IsVisible="{Binding IsEmpty}">
                        <TextBlock Classes="h3" Text="Nothing here yet" HorizontalAlignment="Center" />
                        <TextBlock Classes="dim" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Add a login, note, card or Wi-Fi network with New item, or bring in passwords from your browser, another password manager or a text file with Import." />
                    </StackPanel>
                    <TextBlock Grid.Row="5" Classes="dim" Margin="24,30" TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding HasNoMatches}" Text="Nothing matches. Press Esc in the search box to clear filters." />
                </Grid>
            </Border>

            <!-- Editor -->
            <ContentControl Grid.Column="1" Content="{Binding Editor}" />

            <!-- Home: shown when no item is open. Counts and status only, never names, usernames or sites. -->
            <ScrollViewer Grid.Column="1" IsVisible="{Binding IsHome}">
                <StackPanel MaxWidth="760" Margin="40,36,40,32" Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h1" Text="{Binding Greeting}" />
                        <TextBlock Classes="dim" TextWrapping="Wrap"
                                   Text="{Binding VaultName, StringFormat='{}{0} is unlocked. Pick an item on the left to see it. Nothing private shows here.'}" />
                    </StackPanel>

                    <UniformGrid Columns="4" ColumnSpacing="12">
                        <Button Classes="tile" Command="{Binding ShowTypeCommand}" CommandParameter="Login" AutomationProperties.Name="Show logins">
                            <StackPanel Spacing="6">
                                <PathIcon Data="{StaticResource IconKey}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding LoginCount}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Classes="dim" Text="Logins" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tile" Command="{Binding ShowTypeCommand}" CommandParameter="SecureNote" AutomationProperties.Name="Show notes">
                            <StackPanel Spacing="6">
                                <PathIcon Data="{StaticResource IconNote}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding NoteCount}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Classes="dim" Text="Notes" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tile" Command="{Binding ShowTypeCommand}" CommandParameter="Card" AutomationProperties.Name="Show cards">
                            <StackPanel Spacing="6">
                                <PathIcon Data="{StaticResource IconCard}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding CardCount}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Classes="dim" Text="Cards" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tile" Command="{Binding ShowTypeCommand}" CommandParameter="WiFi" AutomationProperties.Name="Show Wi-Fi networks">
                            <StackPanel Spacing="6">
                                <PathIcon Data="{StaticResource IconWifi}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding WifiCount}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Classes="dim" Text="Wi-Fi" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Surface2}" VerticalAlignment="Center">
                                <Panel>
                                    <PathIcon Data="{StaticResource IconShield}" Width="22" Height="22" Foreground="{StaticResource OkBrush}" IsVisible="{Binding IsHealthy}" />
                                    <PathIcon Data="{StaticResource IconAlert}" Width="22" Height="22" Foreground="{StaticResource WarnBrush}" IsVisible="{Binding !IsHealthy}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="h3" Text="{Binding HealthTitle}" />
                                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Text="{Binding HealthDetail}" />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding OpenCheckupCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconShield}" />
                                    <TextBlock Text="Security check-up" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,16,*">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h3" Text="Safety net" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconSave}" Width="15" Height="15" Foreground="{StaticResource TextDim}" />
                                    <TextBlock Classes="dim" FontSize="13" Text="{Binding LastSavedText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Foreground="{StaticResource TextDim}" />
                                    <TextBlock Classes="dim" FontSize="13" Text="{Binding BackupText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconLock}" Width="15" Height="15" Foreground="{StaticResource TextDim}" />
                                    <TextBlock Classes="dim" FontSize="13" Text="{Binding AutoLockText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h3" Text="Quick actions" />
                                <WrapPanel>
                                    <Button Classes="accent" Command="{Binding NewEntryCommand}" Margin="0,0,8,8" ToolTip.Tip="Ctrl+N">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconPlus}" />
                                            <TextBlock Text="New login" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenImportCommand}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconImport}" />
                                            <TextBlock Text="Import" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenSettingsCommand}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconCog}" />
                                            <TextBlock Text="Settings" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                           Text="Ctrl+F search · Ctrl+N new login · Ctrl+L lock now. Someone walking up? Click Home or press Ctrl+L." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,7">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dim" FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource WarnBrush}" Text="{Binding Countdown}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
